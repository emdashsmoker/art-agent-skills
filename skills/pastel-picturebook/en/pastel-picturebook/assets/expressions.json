{
  "_doc": "Expression presets. add: added to the value; scale: multiplies it; set: moves it to the value; style_scale: multiplies a style value; flags: copied into spec.expression. All blend by expression.amount (default 1).",
  "smile": {
    "add": {
      "mouth.smile": 0.05
    },
    "scale": {
      "eyes.open_down": 0.75
    },
    "set": {
      "eyes.arch": 0.15
    },
    "style_scale": {
      "face_render.blush_opacity": 1.4
    }
  },
  "laugh": {
    "add": {
      "mouth.smile": 0.06,
      "mouth.open": 0.17,
      "eyes.brow_raise": 0.03,
      "mouth.half_width": 0.04
    },
    "set": {
      "eyes.closed": 0.85,
      "eyes.arch": 1.0
    },
    "style_scale": {
      "face_render.blush_opacity": 1.6
    }
  },
  "sad": {
    "add": {
      "mouth.smile": -0.04,
      "eyes.brow_inner": 0.1,
      "eyes.gaze_y": 0.03
    },
    "scale": {
      "eyes.open_up": 0.8
    }
  },
  "cry": {
    "add": {
      "mouth.smile": -0.045,
      "eyes.brow_inner": 0.11,
      "eyes.gaze_y": 0.02,
      "mouth.open": 0.05
    },
    "scale": {
      "eyes.open_up": 0.75
    },
    "style_scale": {
      "face_render.blush_opacity": 1.8
    },
    "flags": {
      "tears": true
    }
  },
  "surprise": {
    "add": {
      "eyes.brow_raise": 0.09,
      "mouth.open": 0.14
    },
    "scale": {
      "eyes.open_up": 1.35,
      "eyes.open_down": 1.3,
      "mouth.half_width": 0.55,
      "eyes.pupil_ratio": 0.8
    }
  },
  "angry": {
    "add": {
      "eyes.brow_inner": -0.09,
      "mouth.smile": -0.03,
      "eyes.brow_slant": 0.3
    },
    "scale": {
      "eyes.open_up": 0.8,
      "mouth.half_width": 0.85
    }
  },
  "wink": {
    "add": {
      "mouth.smile": 0.03
    },
    "set": {
      "eyes.near.closed": 1.0,
      "eyes.near.arch": 0.7
    }
  },
  "kiss": {
    "add": {
      "mouth.smile": 0.01
    },
    "set": {
      "eyes.closed": 1.0
    },
    "style_scale": {
      "face_render.blush_opacity": 1.5
    }
  }
}